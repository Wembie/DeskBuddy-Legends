# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Windows scripts - keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Force binary to avoid corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary
*.aseprite binary
*.psd binary
*.tres binary
*.res binary
*.scn binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.7z binary

